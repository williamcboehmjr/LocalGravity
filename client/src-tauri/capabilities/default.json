{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "shell:default",
    "fs:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-download-and-install",
    "updater:allow-install",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
